# kanshi — display profiles, applied automatically on hotplug.
#
# Started by .config/sway/config:  exec_always sh -c 'pkill kanshi; kanshi'
# Without that line kanshi never runs and none of this takes effect.
#
# The external monitor is matched by "make model serial", not by connector
# name. Connector names are assigned per boot and per port — this panel shows
# up as DP-3 today over USB-C, and would be HDMI-A-1/2 on the HDMI port. The
# make/model/serial string is stable across all of that, so it is what we key
# on. Get the exact string from:
#     swaymsg -t get_outputs -r | jq -r '.[] | "\(.make) \(.model) \(.serial)"'
#
# A profile matches only when the set of connected outputs it names is exactly
# the set that is connected — so 'docked' cannot fire on the laptop alone.

# Docked: the Dell is the only screen. The laptop panel is deliberately off —
# it sits below the monitor when docked and is not worth the neck movement.
profile docked {
  output 'Dell Inc. DELL S3425DW DVLPR44' enable mode 3440x1440@59.973 position 0,0
  output eDP-1 disable
}

# Undocked: laptop panel only.
profile laptop {
  output eDP-1 enable mode 1920x1080@60.056 position 0,0
}
