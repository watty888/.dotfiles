### Variables
#
# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
set $term kitty zsh
# Your preferred application launcher
set $menu fuzzel
# Lock command. Theming lives in .config/swaylock/config, which swaylock reads
# on its own — keeping it out of here means the flags cannot drift out of sync
# with what this swaylock build actually accepts.
#
# It previously passed --screenshots/--effect-blur/--effect-vignette/--fade-in/
# --grace and a bare --indicator. None of those exist in upstream swaylock
# (they are swaylock-effects options), so swaylock exited on a usage error and
# the screen never locked at all — not on idle, not before sleep.
set $lock ~/.config/sway/scripts/lock.sh

### Output configuration
#
# Background: the wallpaper slideshow below takes over a moment after startup
# and rotates through ~/Pictures/Wallpapers. This solid Catppuccin base
# (matching waybar/kitty/swaylock) is what shows until it does, and what you
# fall back to if that directory is ever empty.
#
# Deliberately not an `output * bg /path/to/image.jpg fill` line: hardcoding a
# filename here is what broke the last setup, when the named image was gone and
# the config pointed at nothing. The script picks whatever is actually there.
# The colour itself lives in the theme file (see "Window header colors" below).
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

### Idle configuration
#
# Example configuration:
#
# Plain `exec`, not exec_always: swayidle must be a single instance, and
# wrapping it in `sh -c 'pkill ...; exec swayidle ...'` to make it reload-safe
# breaks — sway substitutes $lock and then sh re-parses the nested quoting,
# and swayidle ends up never starting. Changes here need a sway restart (or
# `pkill swayidle` and rerun by hand), which is the tradeoff for it being
# reliably one process.
#
# `lock` handles loginctl lock-session, so a lock requested by systemd
# actually locks instead of being silently ignored.
exec swayidle -w \
         timeout 300 '$lock' \
         timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
         before-sleep '$lock' \
         lock '$lock'
#
# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.

### Input configuration
#
# Example configuration:
#
input type:keyboard {
    xkb_layout "us,de,ru"
    # grp:alt_shift_toggle deliberately NOT set here. sway/wlroots applies xkb
    # group toggles per input device, so Alt+Shift switched only the keyboard
    # it was pressed on and left the other 16 devices (Glorious, EVO75, the
    # dock, the internal AT keyboard) on the previous layout. The bindsym near
    # the bottom of this file does the same job across `type:keyboard`, i.e.
    # every device at once. Setting both would double-switch and skip a layout.
    xkb_options "caps:ctrl_modifier"
    repeat_delay 250
    repeat_rate 50
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
    pointer_accel 0.2
}
# You can also configure each device individually.
# Read `man 5 sway-input` for more information about this section.

### Key bindings
#
# Basics:
#
    # Start a terminal
    bindsym $mod+Return exec $term

    # Kill focused window
    bindsym $mod+Shift+q kill

    # Start your launcher
    bindsym $mod+d exec $menu

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    # Exit sway (logs you out of your Wayland session)
    bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
#
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10
    # Note: workspaces can have any name you want, not just numbers.
    # We just use 1-10 as the default.
#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+b splith
    bindsym $mod+v splitv

    # Switch the current container between different layout styles
    bindsym $mod+s layout stacking
    bindsym $mod+w layout tabbed
    bindsym $mod+e layout toggle split

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+space focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    # Ditto, with arrow keys
    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"
#
# Utilities:
#
    # Special keys to adjust volume via PulseAudio
    bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
    bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
    bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
    bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle
    # Special keys to adjust brightness via brightnessctl
    bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
    bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
    # The Fn brightness keys send no usable event on this laptop (both send
    # the same bare scancode), so $mod+F2/F3 stand in. -n keeps the panel
    # from reaching 0, which turns the backlight off entirely.
    bindsym --locked $mod+F2 exec brightnessctl -n set 5%-
    bindsym --locked $mod+F3 exec brightnessctl set 5%+
    # Special key to take a screenshot with grim
    bindsym Print exec grim
    
    # Screenshots & screen recording
    bindsym $mod+Shift+s exec sh -c 'grim -g "$(slurp -b "#00000055" -c "#1e66f5")" - | wl-copy'
    bindsym $mod+Shift+Ctrl+s exec sh -c 'grim - | wl-copy'
    # Recording goes through record.sh so waybar can show a live REC pill
    # (click it to stop, too). Saved to ~/Videos/recording_<date>.mp4.
    bindsym $mod+Shift+Ctrl+r exec ~/.config/sway/scripts/record.sh start
    bindsym $mod+Shift+Ctrl+e exec ~/.config/sway/scripts/record.sh stop

    # Lock the screen using swaylock
    bindsym $mod+Ctrl+l exec $lock

    # Notifications (mako)
    bindsym $mod+n exec makoctl dismiss
    bindsym $mod+Shift+n exec makoctl dismiss --all
    # --no-repeat: a toggle; with repeat_delay 250 a slightly long press
    # would fire it twice (on, then straight back off).
    bindsym --no-repeat $mod+Ctrl+n exec ~/.config/waybar/scripts/dnd.sh toggle

    # Light/dark theme: flips Catppuccin Latte <-> Mocha across sway, waybar,
    # mako, fuzzel, swaylock, kitty, nvim and the zsh prompt.
    bindsym $mod+Shift+t exec ~/.config/sway/scripts/theme-switch.sh toggle

# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.

### Window borders and gaps
# Windows float like waybar does (see waybar/style.css): no title bars, a thin
# border that turns gold on the focused window (the gold of the focused
# workspace pill), and gaps that line up with the bar's edges. Waybar's
# sway/window module already shows the focused window's title; tabbed and
# stacked containers still draw their tab titles.
default_border pixel 2
default_floating_border pixel 2

# Tab and stack titles in the same face and size as waybar and kitty.
font pango:JetBrainsMono Nerd Font 11

# Waybar's rounded box sits 10px in from the screen sides with 8px of window
# below it. Sway's gap at a screen edge is inner + outer, so inner 8 between
# windows plus outer 2 puts the window edges at 10px, flush with the bar. At
# the top the bar's own bottom margin already provides 8px, and top -4 adds
# 4px more on top of that, for 12px between the bar and the windows. The bar's
# shadow falls in that space; with no extra room (top -8), the focused window's
# light border sat right against the shadow and read as a rim on the bar.
gaps inner 8
gaps outer 2
gaps top -4

### Window header colors
# Colours (and the solid fallback background) come from the active theme:
# theme.conf is a symlink to themes/latte.conf or themes/mocha.conf, flipped by
# $mod+Shift+t (scripts/theme-switch.sh). It is untracked; the script recreates it.
include ~/.config/sway/theme.conf

# mako — notification daemon (org.freedesktop.Notifications on DBus).
# Plain `exec`, not exec_always: only one process can own that DBus name, so a
# second instance started on reload would just exit with an error. Config
# changes in .config/mako/config apply with `makoctl reload`, no restart.
exec mako

exec blueman-applet
exec nm-applet --indicator

exec_always sh -c 'pkill waybar; waybar'

# kanshi — applies the display profiles in .config/kanshi/config.
# exec_always (not exec) so a sway reload re-applies them, and pkill first
# because a second kanshi would fight the first over every output change.
exec_always sh -c 'pkill kanshi; kanshi'

# ── Keyboard layout switching ───────────────────────────────────────────────
# WHY ALT+SHIFT AND NOT $mod+space: an earlier attempt used the xkb option
# grp:win_space_toggle, which collided with sway's own default binding
# `bindsym $mod+space focus mode_toggle` (see /etc/sway/config). xkb options
# bypass sway's binding table, so sway never knew the key was taken and BOTH
# fired on every press — layout switched *and* focus jumped between tiled and
# floating. No error, no precedence, just two actions.
#
# That no longer applies: switching is a sway bindsym now, so sway arbitrates.
# Binding $mod+space here would simply replace focus mode_toggle instead of
# double-firing — worth remembering if the Alt+Shift chord issue below bites.
#
# THE COST OF ALT+SHIFT: this matches on a modifier pair, so any Alt+Shift+key
# chord switches layout on the way to its real binding. Alt+Shift+Tab is the
# one you will notice.
#
# Alt+Shift, switching every keyboard at once (see the input block above).
# Both orders are bound because the binding matches on whichever of the two
# lands second: Alt-then-Shift emits Shift_L with Mod1 held, Shift-then-Alt
# emits Alt_L with Shift held.
# --no-repeat stops key autorepeat from cycling layouts while held.
#
# --locked keeps the chord working while swaylock is up. Without it sway drops
# the binding for the duration of the lock, so a lock screen was stuck in
# whatever layout it started in — the reason the ru layout used to make the
# session untypeable. scripts/lock.sh now starts every lock in us; this is what
# lets you get to de/ru from there if the password needs it.
#
# Note there is no on-screen layout indicator while locked (swaylock has none),
# so switching is blind. Knowing it always starts at us is what makes it
# countable: one Alt+Shift for de, two for ru.
bindsym --no-repeat --locked Mod1+Shift_L input type:keyboard xkb_switch_layout next
bindsym --no-repeat --locked Shift+Alt_L  input type:keyboard xkb_switch_layout next

# Wallpaper slideshow: cycles ~/Pictures/Wallpapers once a day, plus its mocha/ or
# latte/ subfolder to match the theme (see the script's header). Tune it
# with WALLPAPER_DIR / WALLPAPER_INTERVAL / WALLPAPER_MODE, e.g.
#     exec_always env WALLPAPER_INTERVAL=300 ~/.config/sway/scripts/wallpaper-slideshow.sh
# exec_always, not exec, so `swaymsg reload` picks up script edits; the script
# kills its own previous instance so reloads do not stack up timers.
exec_always ~/.config/sway/scripts/wallpaper-slideshow.sh

# gpg passphrase prompts (pinentry-gtk) float centred with focus. Tiled, a
# prompt started from a background command (pass in a script, Claude Code)
# opened as one more tile beside kitty and the browser, went unnoticed, and
# timed out after 60 s. Started by gpg-agent, pinentry runs under Xwayland
# (class "Pinentry-gtk", no app_id); run by hand on Wayland it has app_id
# "pinentry-gtk". Both rules are needed. "^pinentry" covers -qt as well.
for_window [app_id="^pinentry"] floating enable, move position center, focus
for_window [class="^Pinentry"] floating enable, move position center, focus

# Settings windows opened from waybar (module on-click or the tray applets)
# float centred instead of tiling over whatever was open. GTK3 on Wayland uses
# the binary name as app_id, so blueman's windows are "blueman-manager",
# "blueman-adapters", "blueman-services", "blueman-sendto", and its pairing /
# PIN dialogs come from "blueman-applet"; nm-applet's Wi-Fi password prompt is
# "nm-applet". pavucontrol is "org.pulseaudio.pavucontrol" from 6.0 on, plain
# "pavucontrol" before. The big windows get a fixed size because pavucontrol
# floats far too small by default; dialogs keep their natural size and take
# focus so a password prompt is not missed.
for_window [app_id="^(org\.pulseaudio\.)?pavucontrol$"] floating enable, resize set 960 640, move position center
for_window [app_id="^nm-connection-editor$"] floating enable, move position center
for_window [app_id="^blueman-(manager|adapters|services|sendto)$"] floating enable, resize set 800 560, move position center
for_window [app_id="^(blueman-applet|nm-applet)$"] floating enable, move position center, focus
# btop/htop opened from waybar's system-health pill (waybar/scripts/sysmon-popup.sh):
# a kitty with --class sysmon-popup. Sized in ppt so it fits both the laptop panel
# and the external monitor.
for_window [app_id="^sysmon-popup$"] floating enable, resize set width 75 ppt height 80 ppt, move position center, focus

include /etc/sway/config.d/*
include ~/.config/sway/config.d/*.conf
