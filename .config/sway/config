# mako — notification daemon (org.freedesktop.Notifications on DBus).
# Plain `exec`, not exec_always: only one process can own that DBus name, so a
# second instance started on reload would just exit with an error. Config
# changes in .config/mako/config apply with `makoctl reload`, no restart.
exec mako

exec blueman-applet
exec nm-applet --indicator

exec_always sh -c 'pkill waybar; waybar'

# kanshi — applies the display profiles in .config/kanshi/config.
# exec_always (not exec) so a sway reload re-applies them, and pkill first
# because a second kanshi would fight the first over every output change.
exec_always sh -c 'pkill kanshi; kanshi'

# ── Keyboard layout switching ───────────────────────────────────────────────
# WHY ALT+SHIFT AND NOT $mod+space: an earlier attempt used the xkb option
# grp:win_space_toggle, which collided with sway's own default binding
# `bindsym $mod+space focus mode_toggle` (see /etc/sway/config). xkb options
# bypass sway's binding table, so sway never knew the key was taken and BOTH
# fired on every press — layout switched *and* focus jumped between tiled and
# floating. No error, no precedence, just two actions.
#
# That no longer applies: switching is a sway bindsym now, so sway arbitrates.
# Binding $mod+space here would simply replace focus mode_toggle instead of
# double-firing — worth remembering if the Alt+Shift chord issue below bites.
#
# THE COST OF ALT+SHIFT: this matches on a modifier pair, so any Alt+Shift+key
# chord switches layout on the way to its real binding. Alt+Shift+Tab is the
# one you will notice.
#
# Alt+Shift, switching every keyboard at once (see the input block above).
# Both orders are bound because the binding matches on whichever of the two
# lands second: Alt-then-Shift emits Shift_L with Mod1 held, Shift-then-Alt
# emits Alt_L with Shift held.
# --no-repeat stops key autorepeat from cycling layouts while held.
#
# --locked keeps the chord working while swaylock is up. Without it sway drops
# the binding for the duration of the lock, so a lock screen was stuck in
# whatever layout it started in — the reason the ru layout used to make the
# session untypeable. scripts/lock.sh now starts every lock in us; this is what
# lets you get to de/ru from there if the password needs it.
#
# Note there is no on-screen layout indicator while locked (swaylock has none),
# so switching is blind. Knowing it always starts at us is what makes it
# countable: one Alt+Shift for de, two for ru.
bindsym --no-repeat --locked Mod1+Shift_L input type:keyboard xkb_switch_layout next
bindsym --no-repeat --locked Shift+Alt_L  input type:keyboard xkb_switch_layout next

# Wallpaper slideshow: cycles ~/Pictures/Wallpapers every 10 minutes. Tune it
# with WALLPAPER_DIR / WALLPAPER_INTERVAL / WALLPAPER_MODE, e.g.
#     exec_always env WALLPAPER_INTERVAL=300 ~/.config/sway/scripts/wallpaper-slideshow.sh
# exec_always, not exec, so `swaymsg reload` picks up script edits; the script
# kills its own previous instance so reloads do not stack up timers.
exec_always ~/.config/sway/scripts/wallpaper-slideshow.sh

include /etc/sway/config.d/*
include ~/.config/sway/config.d/*.conf
