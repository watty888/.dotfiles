// waybar — status bar for the sway session.
//
// Launched by .config/sway/config: exec_always sh -c 'pkill waybar; waybar'
// Palette is Catppuccin Latte (see style.css), matching sway, fuzzel and kitty.
//
// Hardware here is an HP Pavilion Gaming 17-cd0xxx: battery BAT1, AC adapter
// ACAD, intel_backlight, wifi wlo1. Those names are baked in below where the
// module cannot discover them on its own.
{
  "layer": "top",
  "position": "top",
  "height": 50,  // 34px bar + 8px floating gap above and below (see style.css)
  "spacing": 4,

  // Both outputs get a bar. kanshi drives which ones are live (docked = the
  // Dell on DP-3 only, laptop = eDP-1 only), and waybar follows whatever
  // exists, so listing both here is what keeps the bar present in either
  // profile rather than only on the laptop panel.
  "modules-left": ["custom/arch", "sway/workspaces", "custom/scratchpad", "sway/mode", "sway/window"],
  "modules-center": ["clock"],
  "modules-right": [
    "custom/recorder",
    "privacy",
    "custom/media",
    "custom/dnd",
    "idle_inhibitor",
    "custom/sysmon",
    "group/levels",
    "custom/headset",
    "network",
    "custom/tailscale",
    "sway/language",
    "battery",
    "tray",
  ],

  // Arch logo at the far left, doubling as the "system" button.
  // Shows the pending update count (repo + AUR) next to the logo when there is
  // one; hover lists the packages. Left-click runs paru in kitty, right-click
  // opens the power menu (incl. one-shot "Reboot into Windows" via grub-reboot).
  // Checks hourly; update-run.sh sends signal 8 to refresh after upgrading.
  "custom/arch": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "return-type": "json",
    "interval": 3600,
    "signal": 8,
    "format": "{}",
    "on-click": "~/.config/waybar/scripts/update-run.sh",
    "on-click-right": "~/.config/waybar/scripts/power-menu.sh",
  },

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": false,
    "format": "{name}",
  },

  // Count of windows hidden in the sway scratchpad (Spotify and Telegram go
  // there by default — see .config/sway/config.d/scratchpad.conf). Hidden
  // entirely when the scratchpad is empty; hover lists what's in it.
  // A script, not the built-in sway/scratchpad module, so that btop (which
  // lives in the scratchpad permanently) isn't counted. Event-driven.
  "custom/scratchpad": {
    "exec": "~/.config/waybar/scripts/scratchpad.sh",
    "return-type": "json",
    "restart-interval": 5,
    "format": "\uf2d2 {}",
  },

  "sway/language": {
    // The layout list is xkb_layout "us,de,ru" in .config/sway/config.
    // Without this there is no way to see which layout is active, which makes
    // a half-working layout switch indistinguishable from a broken one.
    "format": "\u2328 {short}",
    "tooltip-format": "{long}",
    "on-click": "swaymsg input type:keyboard xkb_switch_layout next",
  },

  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>",
  },

  "sway/window": {
    "max-length": 60,
    "tooltip": false,
  },

  "idle_inhibitor": {
    // Mirrors the swayidle setup in the sway config — a visible toggle for
    // "don't blank the screen while I'm reading something".
    "format": "{icon}",
    "format-icons": { "activated": "󰅶", "deactivated": "󰛊" },
    "tooltip-format-activated": "Idle inhibited — screen stays on",
    "tooltip-format-deactivated": "Idle normal — swayidle will lock",
  },

  "tray": {
    // nm-applet and blueman-applet are exec'd by the sway config and live here.
    "icon-size": 16,
    "spacing": 8,
  },

  // Screen recording in progress: red "REC m:ss", click to stop. Absent
  // otherwise. Driven by ~/.config/sway/scripts/record.sh ($mod+Shift+Ctrl+r),
  // which signals once a second while recording; nothing runs otherwise.
  "custom/recorder": {
    "exec": "~/.config/waybar/scripts/recorder.sh",
    "return-type": "json",
    "interval": "once",
    "signal": 11,
    "format": "{}",
    "on-click": "~/.config/sway/scripts/record.sh stop",
  },

  // Bell-off icon while mako's do-not-disturb mode is on ($mod+Ctrl+n), so
  // it can't be forgotten; absent otherwise. Click turns it off.
  "custom/dnd": {
    "exec": "~/.config/waybar/scripts/dnd.sh",
    "return-type": "json",
    "interval": 60,  // fallback; the binding and the click signal it at once
    "signal": 12,
    "format": "{}",
    "on-click": "~/.config/waybar/scripts/dnd.sh off",
  },

  // Mic / screen-share in use (PipeWire streams). Hidden when nothing is.
  // Hover names the app. Doesn't see wlr-screencopy clients, only PipeWire.
  "privacy": {
    "icon-size": 14,
    "icon-spacing": 6,
    "transition-duration": 250,
    "modules": [
      { "type": "screenshare", "tooltip": true, "tooltip-icon-size": 20 },
      { "type": "audio-in", "tooltip": true, "tooltip-icon-size": 20 },
    ],
  },

  // Now playing, from any MPRIS player (Spotify, browser tabs, mpv, ...): the
  // one that's playing, else the paused one, Spotify first on ties. Hidden
  // when nothing is. Updates instantly on change, idle otherwise. A script rather than the built-in mpris module, which
  // got stuck showing a closed player's track (see the script's header).
  // Click: play/pause · right-click: next · middle-click: show its window.
  "custom/media": {
    "exec": "~/.config/waybar/scripts/media.sh",  // long-running, event-driven
    "return-type": "json",
    "restart-interval": 5,  // if playerctl ever dies (D-Bus restart), re-follow
    "format": "{}",
    "max-length": 32,  // the right side is tight; full details in the tooltip
    "on-click": "~/.config/waybar/scripts/media.sh play-pause",
    "on-click-right": "~/.config/waybar/scripts/media.sh next",
    "on-click-middle": "~/.config/waybar/scripts/media.sh show",
  },

  // Volume and brightness share one pill. Volume is always shown; hovering it
  // slides brightness out to its left. Scroll either half to adjust it.
  "group/levels": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 250,
      "transition-left-to-right": false,
      "children-class": "levels-drawer",
    },
    "modules": ["pulseaudio", "backlight"],
  },

  // Battery of connected Bluetooth headphones (via upower). Absent unless one
  // is connected and reports a level; icon follows the level, percentage
  // shown from 20% down. Hover lists devices. Click: blueman-manager.
  "custom/headset": {
    "exec": "~/.config/waybar/scripts/headset.sh",
    "return-type": "json",
    "restart-interval": 5,
    "format": "{}",
    "on-click": "blueman-manager",
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-bluetooth": "󰂰 {volume}%",
    "format-bluetooth-muted": "󰂲 muted",
    "format-icons": { "headphone": "󰋋", "default": ["󰕿", "󰖀", "󰕾"] },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "tooltip-format": "{desc} — {volume}%",
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "tooltip-format": "Brightness {percent}% (laptop panel)",
    "on-scroll-up": "brightnessctl set 2%+",
    "on-scroll-down": "brightnessctl set 2%-",
  },

  "network": {
    // No "interface" key on purpose: this box has wifi (wlo1), onboard
    // ethernet (eno1) and a USB ethernet adapter, so let waybar follow
    // whichever currently holds the default route.
    // Icon only; the network name and addresses are in the tooltip.
    "format-wifi": "{icon}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],  // by signal strength
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-linked": "{ifname}: link up, no IP",
    "tooltip-format-disconnected": "Offline",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}\n↓{bandwidthDownBits} ↑{bandwidthUpBits}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
    "on-click": "nm-connection-editor",
  },

  // Tailnet state, for remote access from the phone. Dim icon while connected;
  // goes loud when tailscaled is down, and shows a count while someone is
  // logged in over SSH. Hover: peers and sessions. Click: copy the 100.x IP.
  "custom/tailscale": {
    "exec": "~/.config/waybar/scripts/tailscale.sh",
    "return-type": "json",
    "interval": 10,
    "signal": 9,
    "format": "{}",
    "on-click": "ip=$(tailscale ip -4) && printf %s \"$ip\" | wl-copy && notify-send -t 2000 Tailscale \"Copied $ip\"",
  },

  // CPU, temperature and RAM folded into one pill: just an icon while all is
  // well, the offending value(s) appear when something crosses a threshold.
  // Hover for the full breakdown (incl. dGPU, zram, disk). Click shows/hides
  // btop, kept running in the sway scratchpad so its graphs have history;
  // right-click toggles a floating htop (scripts/sysmon-popup.sh).
  // Thresholds live at the top of sysmon.sh.
  "custom/sysmon": {
    "exec": "~/.config/waybar/scripts/sysmon.sh",
    "return-type": "json",
    "interval": 5,
    "format": "{}",
    "on-click": "~/.config/waybar/scripts/sysmon-popup.sh btop",
    "on-click-right": "~/.config/waybar/scripts/sysmon-popup.sh htop",
  },

  "battery": {
    "bat": "BAT1",
    "adapter": "ACAD",
    "states": { "warning": 30, "critical": 15 },
    // Icon only. On AC it's a plug (or the charging bolt); on battery the
    // level icon, plus the percentage once it gets low. Hover for details.
    "format": "{icon}",
    "format-discharging-warning": "{icon} {capacity}%",
    "format-discharging-critical": "{icon} {capacity}%",
    "format-charging": "󰂄",
    "format-plugged": "󰚥",
    "format-full": "󰚥",
    "format-not-charging": "󰚥",
    "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰂂", "󰁹"],
    "tooltip-format": "Battery {capacity}% — {timeTo}",
  },

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      // No colours except today's gold: everything else inherits the tooltip
      // text colour from style.css, so it follows the light/dark theme.
      "format": {
        "months": "<b>{}</b>",
        "weekdays": "<b>{}</b>",
        "today": "<span color='#fbc628'><b>{}</b></span>",
      },
    },
    "actions": { "on-click-right": "mode" },
  },
}
